
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the owner of a document (based on a 'userId' field)
    function isOwner(resource) {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }
    
    // Helper function to check if user is a member of a clan (based on custom claims)
    // Assumes a custom claim like 'memberOfClans': ['clanId1', 'clanId2']
    function isClanMember(clanId) {
      return isAuthenticated() && request.auth.token.memberOfClans.hasAny([clanId]);
    }

    // Helper function to check for a specific role/permission (based on custom claims)
    // Example: request.auth.token.canManageFamilyTree == true
    // Example: request.auth.token.role == 'elder'
    function hasClaim(claimName) {
      return isAuthenticated() && request.auth.token[claimName] == true;
    }
    function hasRoleInClan(role, clanIdFromResource) {
      // Assumes claims like: clans: { clanId1: { role: 'elder' }, clanId2: { role: 'member' }}
      // Or a simpler model: clanRoles: { clanId1_elder: true }
      // This example assumes a flat claim like 'isElderOfClan_clanId'
      let claimKey = string(role) + 'OfClan_' + string(clanIdFromResource);
      return isAuthenticated() && request.auth.token[claimKey] == true;
    }

    match /familyTrees/{treeId} {
      allow read: if isAuthenticated(); // Or more specific: if isOwner(resource) || isClanMember(resource.data.clanId);
      allow create: if isAuthenticated(); // User must be authenticated to create
      allow update, delete: if isOwner(resource) || hasClaim('canManageFamilyTree'); // Only owner or someone with specific claim
      
      // Ensure data integrity on create/update
      // allow write: if request.resource.data.userId == request.auth.uid &&
      //                  request.resource.data.familyDataInput is string &&
      //                  request.resource.data.generatedTree is string;
    }

    match /guidanceLogs/{logId} {
      allow read: if isOwner(resource) || hasClaim('canViewAllGuidance');
      allow create: if isAuthenticated();
      // Guidance logs are typically immutable once created
      allow update, delete: if false; 
    }

    match /disputes/{disputeId} {
      allow read: if isAuthenticated(); // Or: if isClanMember(resource.data.clanId) || request.auth.uid == resource.data.submittedBy;
      allow create: if isAuthenticated(); // Anyone authenticated can submit a dispute initially
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.submittedBy || hasRoleInClan('elder', resource.data.clanId));
      // Elders can update status, add agent suggestions, etc. SubmittedBy might update testimonies.
      allow delete: if hasRoleInClan('admin', resource.data.clanId); // Only admins can delete
    }
    
    match /rites/{riteId} {
      allow read: if isAuthenticated(); // Or more specific: if isClanMember(resource.data.clanId) || request.auth.uid == resource.data.memberId;
      allow create: if isAuthenticated(); // Authenticated users can log rites (further checks in API via claims)
      allow update: if isOwner(resource) || hasRoleInClan('elder', resource.data.clanId); // User who logged it or an elder
      allow delete: if hasRoleInClan('admin', resource.data.clanId);
    }

    match /agent_logs/{logId} {
      // Agent logs are generally for audit and should be append-only from backend/admin SDK.
      // Frontend might read specific logs if a user needs to see their own agent interactions.
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.context.requested_by_uid || hasClaim('canViewAgentLogs'));
      allow create: if false; // Should only be created by backend admin SDK
      allow update, delete: if false; // Immutable
    }

    // Example for 'members' collection (assuming it exists)
    match /members/{memberId} {
      allow read: if isAuthenticated(); // Or isClanMember(resource.data.clanId)
      allow create: if hasClaim('canAddMembers'); // e.g., an admin or elder role
      allow update: if request.auth.uid == resource.id || hasRoleInClan('elder', resource.data.clanId); // User can update their own, elders can update members of their clan
      allow delete: if hasRoleInClan('admin', resource.data.clanId);
    }
    
    // Example for 'clans' collection
    match /clans/{clanId} {
      allow read: if isAuthenticated(); // Any authenticated user can read clan info
      allow create, update, delete: if hasClaim('canManageClans'); // Only users with a specific high-level claim
    }
  }
}
